    <DebugType>None</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BUtil.Tasks.IncrementalBackup/BUtil.Tasks.IncrementalBackup.csproj" />
    <ProjectReference Include="../BUtil.UI.Common/BUtil.UI.Common.csproj" />
    <ProjectReference Include="../BUtil.UI.Tasks/BUtil.UI.Tasks.csproj" />
    <ProjectReference Include="../BUtil.UI.Storages/BUtil.UI.Storages.csproj" />
    <ProjectReference Include="..\BUtil.Tasks.Common\BUtil.Tasks.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Controls\EditIncrementalBackupTaskView.axaml.cs">
      <DependentUpon>EditIncrementalBackupTaskView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\WhatTaskView.axaml.cs">
      <DependentUpon>WhatTaskView.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\ExcludePatternsField.axaml.cs">
      <DependentUpon>ExcludePatternsField.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
