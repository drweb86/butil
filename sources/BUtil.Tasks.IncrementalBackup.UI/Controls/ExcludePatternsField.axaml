<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:decor="clr-namespace:BUtil.UI.Controls;assembly=BUtil.UI.Common"
             mc:Ignorable="d"
             x:Class="BUtil.Tasks.IncrementalBackup.UI.Controls.ExcludePatternsField"
			 x:Name="Root">
	<Expander Classes="TaskSection" HorizontalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
		<Expander.Header>
			<decor:ExpanderHeader Icon="✂" Text="{Binding #Root.HeaderText}" />
		</Expander.Header>
		<decor:TextFieldWithAction
			Label="{Binding #Root.Label}"
			Text="{Binding #Root.Patterns, Mode=TwoWay}"
			IsMultiline="True"
			TextWrapping="Wrap"
			TextBoxMinHeight="150"
			ActionText="{Binding #Root.ActionText}"
			ActionCommand="{Binding #Root.GlobbingHelpCommand}"
			Help="{Binding #Root.Help}" />
	</Expander>
</UserControl>
