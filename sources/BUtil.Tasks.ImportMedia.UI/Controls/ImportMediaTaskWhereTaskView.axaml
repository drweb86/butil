<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:cvm="clr-namespace:BUtil.UI.Controls;assembly=BUtil.Tasks.ImportMedia.UI"
			 xmlns:decor="clr-namespace:BUtil.UI.Controls;assembly=BUtil.UI.Common"
             mc:Ignorable="d"
             x:Class="BUtil.UI.Controls.ImportMediaTaskWhereTaskView"
			 x:DataType="cvm:ImportMediaTaskWhereTaskViewModel">
	<Expander Classes="TaskSection" HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
		<Expander.Header>
			<decor:ExpanderHeader Icon="🖼" Text="{Binding LeftMenu_Where}" />
		</Expander.Header>
		<StackPanel>
			<decor:TextFieldWithAction
				Label="{Binding ImportMediaTask_Field_OutputFolder}"
				Text="{Binding OutputFolder}"
				ActionIcon="📂"
				ActionText="{Binding Field_Folder_Browse}"
				ActionCommand="{Binding BrowseOutputFolderCommand}"
				Error="{Binding OutputFolderError}" />

			<decor:DropdownField
				Label="{Binding ImportMediaTask_Field_TransformFileName}"
				IsEditable="True"
				Text="{Binding TransformFileName}"
				ItemsSource="{Binding TransformFileNamePresets}"
				ActionIcon="📖"
				ActionText="{Binding ImportMediaTask_Field_TransformFileName_Documentation}"
				ActionCommand="{Binding OpenDateTimeFormatDocsCommand}"
				Help="{Binding TransformFileNameHelp}"
				Error="{Binding TransformFileNameError}" />
		</StackPanel>
	</Expander>
</UserControl>