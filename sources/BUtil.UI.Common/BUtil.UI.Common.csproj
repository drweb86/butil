<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugSymbols>False</DebugSymbols>
    <DebugType>None</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.1" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="DialogHost.Avalonia" Version="0.12.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../BUtil.Core/BUtil.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\ValidationError.axaml.cs">
      <DependentUpon>ValidationError.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\ViewDecoration.axaml.cs">
      <DependentUpon>ViewDecoration.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\TextField.axaml.cs">
      <DependentUpon>TextField.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\TextFieldWithAction.axaml.cs">
      <DependentUpon>TextFieldWithAction.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\IconButton.axaml.cs">
      <DependentUpon>IconButton.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\GridRowButton.axaml.cs">
      <DependentUpon>GridRowButton.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\MessageBar.axaml.cs">
      <DependentUpon>MessageBar.axaml</DependentUpon>
    </Compile>
    <Compile Update="Controls\DialogButtons.axaml.cs">
      <DependentUpon>DialogButtons.axaml</DependentUpon>
    </Compile>
  </ItemGroup>
</Project>
