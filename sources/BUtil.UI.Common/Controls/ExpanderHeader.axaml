<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:decor="clr-namespace:BUtil.UI.Controls;assembly=BUtil.UI.Common"
             mc:Ignorable="d"
             x:Class="BUtil.UI.Controls.ExpanderHeader"
			 x:DataType="decor:ExpanderHeader">
	<StackPanel Orientation="Horizontal" Spacing="4">
		<TextBlock Text="{Binding Icon, RelativeSource={RelativeSource AncestorType=decor:ExpanderHeader}}" />
		<TextBlock Text="{Binding Text, RelativeSource={RelativeSource AncestorType=decor:ExpanderHeader}}" />
	</StackPanel>
</UserControl>
