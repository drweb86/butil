<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BUtil.UI.Controls"
             x:Class="BUtil.UI.Controls.DialogButtons"
             x:Name="Root"
			 Margin="0 8 0 8">
	<StackPanel>
		<StackPanel.Styles>
			<Style Selector="Button">
				<Setter Property="Margin" Value="4" />
				<Setter Property="MinWidth" Value="120" />
				<Setter Property="HorizontalContentAlignment" Value="Center" />
				<Setter Property="Padding" Value="32 32 32 32" />
			</Style>
		</StackPanel.Styles>
		<local:MessageBar Text="{Binding #Root.MessageText}" Kind="{Binding #Root.MessageKind}" />
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
			<Button IsDefault="True"
					Content="{Binding #Root.PrimaryText}"
					Command="{Binding #Root.PrimaryCommand}" />
			<Button IsCancel="True"
					Content="{Binding #Root.CancelText}"
					Command="{Binding #Root.CancelCommand}" />
		</StackPanel>
	</StackPanel>
</UserControl>
