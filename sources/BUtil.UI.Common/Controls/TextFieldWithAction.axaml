<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BUtil.UI.Controls"
			 xmlns:decor="clr-namespace:BUtil.UI.Controls;assembly=BUtil.UI.Common"
             x:Class="BUtil.UI.Controls.TextFieldWithAction"
             x:Name="Root"
             Margin="0 8 0 8">
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition Width="*" />
			<ColumnDefinition Width="Auto" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
			<RowDefinition />
		</Grid.RowDefinitions>
		<TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding #Root.Label}" Margin="0 0 0 8" />
		<TextBox Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0 0 8 0"
				IsReadOnly="{Binding #Root.IsReadOnly}"
				AcceptsReturn="{Binding #Root.IsMultiline}"
				TextWrapping="{Binding #Root.TextWrapping}"
				MinHeight="{Binding #Root.TextBoxMinHeight}"
				Text="{Binding #Root.Text, Mode=TwoWay}" />
		<Button Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"
				IsVisible="{Binding !#Root.IsMultiline}"
				Content="{Binding #Root.ActionText}"
				Command="{Binding #Root.ActionCommand}" />
		<Button Grid.Row="2" Grid.Column="0" HorizontalAlignment="Left" Margin="0 8 0 0"
				IsVisible="{Binding #Root.IsMultiline}"
				Content="{Binding #Root.ActionText}"
				Command="{Binding #Root.ActionCommand}" />
		<TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
				IsVisible="{Binding #Root.Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
				Text="{Binding #Root.Help}" TextWrapping="Wrap" Margin="0 8 0 0" />
		<decor:ValidationError
			Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
			Error="{Binding #Root.Error}" />
	</Grid>
</UserControl>
