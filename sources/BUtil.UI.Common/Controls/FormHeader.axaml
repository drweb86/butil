<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BUtil.UI.Controls.FormHeader"
             x:Name="Root"
			 HorizontalContentAlignment="Center"
			 Margin="0 0 0 8">
	<TextBlock Text="{Binding #Root.Text}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
</UserControl>
