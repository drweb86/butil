<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:cvm="clr-namespace:BUtil.UI.Controls"
             xmlns:sfvm="clr-namespace:BUtil.UI.Controls.StorageFields"
             xmlns:decor="clr-namespace:BUtil.UI.Controls;assembly=BUtil.UI.Common"
             mc:Ignorable="d"
             x:Class="BUtil.UI.Controls.StorageView"
             x:DataType="cvm:StorageViewModel">
	<Expander Classes="TaskSection" HorizontalAlignment="Stretch" IsExpanded="{Binding IsExpanded}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
		<Expander.Header>
			<decor:ExpanderHeader Icon="💾" Text="{Binding Title}" />
		</Expander.Header>
		<StackPanel Spacing="4" Margin="0 4 0 0">

			<TextBlock Text="{Binding Help}"
			           TextWrapping="Wrap"
			           IsVisible="{Binding Help, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

			<!-- Transport protocol -->
			<decor:DropdownField
				Label="{Binding Field_TransportProtocol}"
				ItemsSource="{Binding Providers}"
				SelectedItem="{Binding SelectedProvider}"
				DisplayMember="DisplayName" />

			<!-- Per-storage-type fields — rendered from provider metadata, no XAML changes needed for new types -->
			<ItemsControl ItemsSource="{Binding Fields}">
				<ItemsControl.DataTemplates>

					<DataTemplate x:DataType="sfvm:TextFieldViewModel">
						<decor:TextField
							IsVisible="{Binding IsFieldVisible}"
							Label="{Binding DisplayLabel}"
							Placeholder="{Binding DisplayPlaceholder}"
							Text="{Binding Value}"
							Error="{Binding Error}" />
					</DataTemplate>

					<DataTemplate x:DataType="sfvm:PasswordFieldViewModel">
						<decor:TextField
							IsVisible="{Binding IsFieldVisible}"
							Label="{Binding DisplayLabel}"
							PasswordChar="*"
							Text="{Binding Value}"
							Error="{Binding Error}" />
					</DataTemplate>

					<DataTemplate x:DataType="sfvm:IntegerFieldViewModel">
						<decor:NumericUpDownField
							IsVisible="{Binding IsFieldVisible}"
							Label="{Binding DisplayLabel}"
							Minimum="{Binding Minimum}"
							Maximum="{Binding Maximum}"
							Value="{Binding Value}"
							Error="{Binding Error}" />
					</DataTemplate>

					<DataTemplate x:DataType="sfvm:FolderFieldViewModel">
						<decor:TextFieldWithAction
							IsVisible="{Binding IsFieldVisible}"
							Label="{Binding DisplayLabel}"
							Placeholder="{Binding DisplayPlaceholder}"
							Text="{Binding Value}"
							ActionText="{Binding BrowseLabel}"
							ActionIcon="📂"
							ActionCommand="{Binding BrowseCommand}"
							Error="{Binding Error}" />
					</DataTemplate>

					<DataTemplate x:DataType="sfvm:FileFieldViewModel">
						<decor:TextFieldWithAction
							IsVisible="{Binding IsFieldVisible}"
							Label="{Binding DisplayLabel}"
							Placeholder="{Binding DisplayPlaceholder}"
							Text="{Binding Value}"
							ActionText="{Binding BrowseLabel}"
							ActionIcon="📂"
							ActionCommand="{Binding BrowseCommand}"
							Error="{Binding Error}" />
					</DataTemplate>

					<DataTemplate x:DataType="sfvm:EnumFieldViewModel">
						<decor:DropdownField
							IsVisible="{Binding IsFieldVisible}"
							Label="{Binding DisplayLabel}"
							ItemsSource="{Binding DisplayOptions}"
							SelectedItem="{Binding SelectedDisplay}"
							Help="{Binding ChoiceHelp}"
							Error="{Binding Error}" />
					</DataTemplate>

				</ItemsControl.DataTemplates>
			</ItemsControl>

			<!-- Quota (common to all storage types) — placed after storage-specific fields -->
			<decor:NumericUpDownField
				Label="{Binding DataStorage_Field_UploadQuota}"
				Minimum="0"
				Value="{Binding Quota}"
				Help="{Binding DataStorage_Field_UploadQuota_Help}"
				Error="{Binding QuotaError}" />

			<!-- Mount/unmount scripts (shown only when platform supports script execution) -->
			<Expander Classes="TaskSection" IsVisible="{Binding CanLaunchScripts}" HorizontalAlignment="Stretch">
				<Expander.Header>
					<decor:ExpanderHeader Icon="🌍" Text="{Binding DataStorage_Scripts_Header}" />
				</Expander.Header>
				<StackPanel>
					<TextBlock Text="{Binding DataStorage_Script_Help}" VerticalAlignment="Center" TextWrapping="Wrap" />
					<decor:TextFieldWithAction
						Label="{Binding DataStorage_Field_ConnectScript}"
						Text="{Binding MountScript}"
						IsMultiline="True"
						TextWrapping="Wrap"
						TextBoxMinHeight="150"
						ActionIcon="🚀"
						ActionText="{Binding Task_Launch}"
						ActionCommand="{Binding MountScriptLaunchCommand}" />
					<decor:MessageBar
						Text="{Binding MountScriptMessage}"
						Kind="{Binding MountScriptMessageKind}" />
					<decor:TextFieldWithAction
						Label="{Binding DataStorage_Field_DisconnectionScript}"
						Text="{Binding UnmountScript}"
						IsMultiline="True"
						TextWrapping="Wrap"
						TextBoxMinHeight="150"
						ActionIcon="🚀"
						ActionText="{Binding Task_Launch}"
						ActionCommand="{Binding UnmountScriptLaunchCommand}" />
					<decor:MessageBar
						Text="{Binding UnmountScriptMessage}"
						Kind="{Binding UnmountScriptMessageKind}" />
				</StackPanel>
			</Expander>

			<decor:ValidationError Error="{Binding Error}" Margin="0 0 0 8" />

		</StackPanel>
	</Expander>
</UserControl>
