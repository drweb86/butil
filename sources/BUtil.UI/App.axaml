<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BUtil.UI.App"
             xmlns:local="using:BUtil.UI">
    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
    <Application.Styles>
        <FluentTheme />
		<StyleInclude Source="avares://BUtil.UI/Themes/TaskSectionExpander.axaml" />
		<StyleInclude Source="avares://BUtil.UI/Themes/FormContent.axaml" />
    </Application.Styles>
</Application>
