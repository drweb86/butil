<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BUtil.UI.Controls"
             xmlns:decor="clr-namespace:BUtil.UI.Controls;assembly=BUtil.UI.Common"
             x:Class="BUtil.UI.Controls.MarkdownPageView"
             x:Name="Root"
             x:DataType="controls:MarkdownPageViewModel">
	<Grid Margin="24">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<decor:FormHeader Grid.Row="0" Text="{Binding WindowTitle}" Margin="0,0,0,12" />
		<ScrollViewer Grid.Row="1"
		              VerticalScrollBarVisibility="Auto"
		              HorizontalScrollBarVisibility="Disabled">
			<StackPanel x:Name="DocumentHost" />
		</ScrollViewer>
		<Button Grid.Row="2"
		        Content="{Binding CloseLabel}"
		        HorizontalAlignment="Stretch"
		        HorizontalContentAlignment="Center"
		        Margin="0,12,0,0"
		        Command="{Binding CloseCommand}" />
	</Grid>
</UserControl>
