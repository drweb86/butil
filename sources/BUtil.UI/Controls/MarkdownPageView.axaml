<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BUtil.UI.Controls"
             xmlns:decor="clr-namespace:BUtil.UI.Controls;assembly=BUtil.UI.Common"
             x:Class="BUtil.UI.Controls.MarkdownPageView"
             x:Name="Root"
             x:DataType="controls:MarkdownPageViewModel">
	<Grid Classes="FormContent" VerticalAlignment="Stretch">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<decor:FormHeader Grid.Row="0" Text="{Binding WindowTitle}" />
		<ScrollViewer Grid.Row="1"
		              VerticalScrollBarVisibility="Auto"
		              HorizontalScrollBarVisibility="Disabled">
			<StackPanel x:Name="DocumentHost" />
		</ScrollViewer>
		<decor:DialogButtons Grid.Row="2"
		                     IsPrimaryVisible="False"
		                     CancelText="{Binding CloseLabel}"
		                     CancelCommand="{Binding CloseCommand}" />
	</Grid>
</UserControl>
