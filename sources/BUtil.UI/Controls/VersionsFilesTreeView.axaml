<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 xmlns:cvm="clr-namespace:BUtil.UI.Controls"
			 xmlns:decor="clr-namespace:BUtil.UI.Controls;assembly=BUtil.UI.Common"
             mc:Ignorable="d"
             x:Class="BUtil.UI.Controls.VersionsFilesTreeView"
			 x:Name="Root"
			 x:DataType="cvm:VersionsFilesTreeView">
	<Expander Classes="TaskSection" HorizontalAlignment="Stretch" IsExpanded="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Background="Transparent">
		<Expander.Header>
			<decor:ExpanderHeader Icon="💾" Text="{Binding #Root.Title}" />
		</Expander.Header>
		<StackPanel>
			<TextBlock TextWrapping="Wrap" Margin="0 0 0 8" Text="{Binding #Root.Help}" />
			<decor:IconButton
				Icon="💾"
				Text="{Binding #Root.RestoreText}"
				IsEnabled="{Binding #Root.IsRestoreEnabled}"
				Command="{Binding #Root.BrowseRestoreFolderAsync}" />
			<TextBox
				Text="{Binding #Root.SearchText}"
				PlaceholderText="{Binding #Root.SearchPlaceholder}"
				Margin="0 0 0 8"
				VerticalContentAlignment="Center" />
			<TreeView
				ItemsSource="{Binding #Root.Nodes}"
				SelectionMode="Single"
				SelectedItem="{Binding #Root.SelectedNode}"
				HorizontalAlignment="Stretch">
				<TreeView.Styles>
					<Style Selector="TreeViewItem" x:DataType="cvm:FileTreeNode">
						<Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
					</Style>
				</TreeView.Styles>
				<TreeView.ItemTemplate>
					<TreeDataTemplate ItemsSource="{Binding Nodes}" DataType="cvm:FileTreeNode">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Spacing="4">
							<TextBlock
								VerticalAlignment="Center"
								Text="{Binding Icon}" />
							<TextBlock
								TextWrapping="Wrap"
								VerticalAlignment="Center"
								HorizontalAlignment="Stretch"
								Text="{Binding Target}" />
						</StackPanel>
					</TreeDataTemplate>
				</TreeView.ItemTemplate>
			</TreeView>
		</StackPanel>
	</Expander>
</UserControl>
